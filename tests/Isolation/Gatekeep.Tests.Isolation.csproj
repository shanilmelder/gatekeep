<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Keeps `dotnet test <path>` working: the new runner on SDK 10 needs a project flag. -->
