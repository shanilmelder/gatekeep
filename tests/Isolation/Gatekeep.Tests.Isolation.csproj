    <ProjectReference Include="../../src/Gatekeep.Cli/Gatekeep.Cli.csproj" />
    <ProjectReference Include="../../src/Modules/Admins/Gatekeep.Modules.Admins.csproj" />
    <ProjectReference Include="../../src/Modules/Audit/Gatekeep.Modules.Audit.csproj" />
