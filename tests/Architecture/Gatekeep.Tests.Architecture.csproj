<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Keeps `dotnet test <path>` working: the new runner on SDK 10 needs a project flag. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generator/**" />
    <Compile Include="Generator/EdgeList.cs" Link="EdgeList.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Gatekeep.Kernel/Gatekeep.Kernel.csproj" />
  </ItemGroup>

</Project>
