# Files that run or are read on Linux keep LF on every checkout.
*.sh      text eol=lf
*.hcl     text eol=lf
*.service text eol=lf
Caddyfile text eol=lf
*.caddy   text eol=lf

# Generated design tokens (AD-22) keep LF, the generator's line endings, on every checkout.
packages/design-tokens/css/tokens.css            text eol=lf
packages/design-tokens/src/tokens.generated.ts   text eol=lf
src/Modules/Tenancy/Core/Theme/DesignTokens.g.cs text eol=lf

# The bundled fonts and their licence stay byte for byte the pinned geist release.
packages/ui/src/fonts/** -text

# The committed API contract (Story 1.21) keeps LF, its generators' line endings, so the
# pipeline's drift check compares it byte for byte on every checkout.
docs/api/openapi-v1.json                   text eol=lf
packages/api-client/src/schema.generated.ts text eol=lf
