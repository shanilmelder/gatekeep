{
  "openapi": "3.1.1",
  "info": {
    "title": "Gatekeep Admin API",
    "description": "The Admin Dashboard's API on Host.Admin. Every /api/v1/deployment endpoint but the bootstrap claim and Admin sign-in needs the __Host-gk-admin Session cookie; every state-changing one also needs the exact Admin Origin and the Session's X-Gatekeep-CSRF token. The claim and sign-in need the exact Admin Origin only. A refusal's body is only a fixed code and the trace ID.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/deployment/bootstrap": {
      "post": {
        "tags": [
          "Deployment"
        ],
        "summary": "Claim bootstrap with the one-time token and create the first Admin.",
        "description": "Consumes the token from gatekeep init, creates the first Admin as Deployment Owner, completes bootstrap and starts a setup-restricted Admin Session in one transaction. Needs the exact Admin Origin, and has no session or CSRF check. Each claim is counted per client before the token is compared: the sixth in 15 minutes is 429. Once bootstrap is complete, or before init, it is the unknown-path 404.",
        "operationId": "ClaimBootstrap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "description": "The Admin Session: __Host-gk-admin={43 base64url characters}; Path=/; Secure; HttpOnly; SameSite=Strict. A browser session cookie, with no Domain, Expires or Max-Age.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapClaimResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until this client's claim window ends and it may claim again.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [ ],
        "x-gatekeep-setup-allowed": false
      }
    },
    "/api/v1/deployment/signin": {
      "post": {
        "tags": [
          "Deployment"
        ],
        "summary": "Begin an Admin sign-in with WebAuthn: the options for navigator.credentials.get.",
        "description": "Sessionless: needs the exact Admin Origin, and has no session or CSRF check. Returns request options for the Admin RP ID with user verification required and no allowed credentials listed: the credential is discoverable, so no username is asked for and no credential ID is sent. Sets the __Host-gk-admin-signin cookie that binds the challenge to this browser; it can be answered once, within 5 minutes, and a new begin replaces it. Each begin is counted per client: the 21st in 15 minutes is 429. Before bootstrap completes it is the unknown-path 404.",
        "operationId": "BeginSignIn",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "description": "The sign-in binding: __Host-gk-admin-signin={43 base64url characters}; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=300. The complete call must carry it.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSignInOptionsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the rate-limit window allows another request.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [ ],
        "x-gatekeep-setup-allowed": false
      }
    },
    "/api/v1/deployment/signin/complete": {
      "post": {
        "tags": [
          "Deployment"
        ],
        "summary": "Complete an Admin sign-in with the browser's WebAuthn assertion, and start a full Admin Session.",
        "description": "Sessionless: needs the exact Admin Origin and the __Host-gk-admin-signin cookie from the begin. Once the call is counted, the challenge that cookie names is taken before the body is read, so it is used up whatever follows, and every response clears the cookie. A 429, or a 503 for a missing client address, comes before that and leaves the challenge live. Verifies the assertion against the Admin RP ID, the exact Admin origin and the registered credential it names, with user verification, the credential owner's user handle and a signature counter that advances. Every refusal is the same 400 signin_refused, with no Session. A sign-in starts a full Session; an Admin without two credentials still reaches only setup. A live Session this browser held is ended as superseded. Each complete is counted per client, a success too: the 11th in 15 minutes is 429. Before bootstrap completes it is the unknown-path 404.",
        "operationId": "CompleteSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "description": "The Admin Session: __Host-gk-admin={43 base64url characters}; Path=/; Secure; HttpOnly; SameSite=Strict, a browser session cookie with no Domain, Expires or Max-Age. And __Host-gk-admin-signin cleared with Max-Age=0, as on every complete.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSignInResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the rate-limit window allows another request.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [ ],
        "x-gatekeep-setup-allowed": false
      }
    },
    "/api/v1/deployment/session": {
      "get": {
        "tags": [
          "Deployment"
        ],
        "summary": "The current Admin Session and its CSRF token.",
        "description": "Setup-allowed and read-only: the CSRF token is the Session's, the same each time and in every tab.",
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "adminSession": [ ]
          }
        ],
        "x-gatekeep-setup-allowed": true
      },
      "delete": {
        "tags": [
          "Deployment"
        ],
        "summary": "Sign out: end the current Admin Session.",
        "description": "Ends the Session as signed_out, writes admin.session.signed_out, and clears the cookie. Not setup-allowed: a setup Session signing out would leave the Deployment Owner unable to finish setup.",
        "operationId": "EndSession",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "adminSession": [ ],
            "csrf": [ ]
          }
        ],
        "x-gatekeep-setup-allowed": false
      }
    },
    "/api/v1/deployment/credentials/registration": {
      "post": {
        "tags": [
          "Deployment"
        ],
        "summary": "Begin registering a WebAuthn credential: the options for navigator.credentials.create.",
        "description": "Setup-allowed. Returns creation options for the Admin RP ID and origin, with no attestation, user verification required, a resident key required, ES256 and RS256, and the Admin's credentials excluded. Its challenge can be answered for 5 minutes, by the next complete call only; a new begin replaces it. Refused with 403 once the Admin has two credentials. Each begin and complete counts towards 10 per Session in 15 minutes, then 429.",
        "operationId": "BeginCredentialRegistration",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialCreationOptionsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the rate-limit window allows another request.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "adminSession": [ ],
            "csrf": [ ]
          }
        ],
        "x-gatekeep-setup-allowed": true
      }
    },
    "/api/v1/deployment/credentials/registration/complete": {
      "post": {
        "tags": [
          "Deployment"
        ],
        "summary": "Complete a WebAuthn credential registration with the browser's attestation response.",
        "description": "Setup-allowed. Verifies the response against the pending challenge, the Admin RP ID and the exact Admin origin, and stores the credential. The challenge is used up whatever the outcome. A response for another RP ID or origin, a cross-origin one, one without user verification, one with no live challenge and one returning an existing credential are 400 credential_refused, with nothing stored. The second credential completes setup: the Session becomes full. Refused with 403 once the Admin has two credentials.",
        "operationId": "CompleteCredentialRegistration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the rate-limit window allows another request.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "adminSession": [ ],
            "csrf": [ ]
          }
        ],
        "x-gatekeep-setup-allowed": true
      }
    },
    "/api/v1/deployment/capabilities": {
      "get": {
        "tags": [
          "Deployment"
        ],
        "summary": "The Deployment capabilities the current Admin holds.",
        "description": "Not setup-allowed: a setup Session gets 403. Empty until Story 1.24 grants capabilities.",
        "operationId": "GetCapabilities",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "adminSession": [ ]
          }
        ],
        "x-gatekeep-setup-allowed": false
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSessionResponse": {
        "required": [
          "adminId",
          "kind",
          "deploymentOwner",
          "setupComplete",
          "credentials",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "adminId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "setup",
              "full"
            ],
            "type": "string"
          },
          "deploymentOwner": {
            "type": "boolean"
          },
          "setupComplete": {
            "type": "boolean"
          },
          "credentials": {
            "type": "integer",
            "format": "int32"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "AdminSignInOptionsResponse": {
        "required": [
          "challenge",
          "rpId",
          "timeout",
          "userVerification",
          "allowCredentials"
        ],
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string"
          },
          "rpId": {
            "type": "string"
          },
          "timeout": {
            "type": "integer",
            "format": "int64"
          },
          "userVerification": {
            "enum": [
              "required"
            ],
            "type": "string"
          },
          "allowCredentials": {
            "maxItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationExcludedCredential"
            }
          }
        }
      },
      "AdminSignInRequest": {
        "required": [
          "id",
          "rawId",
          "type",
          "response"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rawId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "public-key"
            ],
            "type": "string"
          },
          "response": {
            "required": [
              "clientDataJSON",
              "authenticatorData",
              "signature"
            ],
            "type": "object",
            "properties": {
              "clientDataJSON": {
                "type": "string"
              },
              "authenticatorData": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "userHandle": {
                "type": [
                  "null",
                  "string"
                ]
              }
            }
          }
        }
      },
      "AdminSignInResponse": {
        "required": [
          "adminId",
          "csrfToken",
          "setupComplete"
        ],
        "type": "object",
        "properties": {
          "adminId": {
            "type": "string",
            "format": "uuid"
          },
          "csrfToken": {
            "type": "string"
          },
          "setupComplete": {
            "type": "boolean"
          }
        }
      },
      "ApiProblem": {
        "required": [
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "bootstrap_refused",
              "credential_refused",
              "signin_refused",
              "rate_limited"
            ],
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "BootstrapClaimRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "BootstrapClaimResponse": {
        "required": [
          "csrfToken",
          "adminId"
        ],
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "adminId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CapabilitiesResponse": {
        "required": [
          "capabilities"
        ],
        "type": "object",
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CredentialCreationOptionsResponse": {
        "required": [
          "rp",
          "user",
          "challenge",
          "pubKeyCredParams",
          "timeout",
          "attestation",
          "authenticatorSelection",
          "excludeCredentials"
        ],
        "type": "object",
        "properties": {
          "rp": {
            "$ref": "#/components/schemas/RegistrationRelyingParty"
          },
          "user": {
            "$ref": "#/components/schemas/RegistrationUser"
          },
          "challenge": {
            "type": "string"
          },
          "pubKeyCredParams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationPublicKeyParameter"
            }
          },
          "timeout": {
            "type": "integer",
            "format": "int64"
          },
          "attestation": {
            "enum": [
              "none"
            ],
            "type": "string"
          },
          "authenticatorSelection": {
            "$ref": "#/components/schemas/RegistrationAuthenticatorSelection"
          },
          "excludeCredentials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationExcludedCredential"
            }
          }
        }
      },
      "CredentialRegistrationRequest": {
        "required": [
          "id",
          "rawId",
          "type",
          "response"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rawId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "public-key"
            ],
            "type": "string"
          },
          "response": {
            "required": [
              "clientDataJSON",
              "attestationObject"
            ],
            "type": "object",
            "properties": {
              "clientDataJSON": {
                "type": "string"
              },
              "attestationObject": {
                "type": "string"
              },
              "transports": {
                "type": [
                  "null",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CredentialRegistrationResponse": {
        "required": [
          "credentials",
          "setupComplete"
        ],
        "type": "object",
        "properties": {
          "credentials": {
            "type": "integer",
            "format": "int32"
          },
          "setupComplete": {
            "type": "boolean"
          }
        }
      },
      "RegistrationAuthenticatorSelection": {
        "required": [
          "residentKey",
          "userVerification"
        ],
        "type": "object",
        "properties": {
          "residentKey": {
            "enum": [
              "required"
            ],
            "type": "string"
          },
          "userVerification": {
            "enum": [
              "required"
            ],
            "type": "string"
          }
        }
      },
      "RegistrationExcludedCredential": {
        "required": [
          "type",
          "id",
          "transports"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "public-key"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "transports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegistrationPublicKeyParameter": {
        "required": [
          "type",
          "alg"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "public-key"
            ],
            "type": "string"
          },
          "alg": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RegistrationRelyingParty": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "RegistrationUser": {
        "required": [
          "id",
          "name",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "description": "The Admin Session: Secure, HttpOnly, SameSite=Strict, host-only. 30 minutes idle, 8 hours absolute.",
        "name": "__Host-gk-admin",
        "in": "cookie"
      },
      "csrf": {
        "type": "apiKey",
        "description": "The Session's CSRF token, from the claim or GET /api/v1/deployment/session. Required on state-changing requests.",
        "name": "X-Gatekeep-CSRF",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "Deployment"
    }
  ]
}