{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The package ships its TypeScript and CSS Modules source, and each app's Vite build
    // compiles them (AD-22: static CSS only). This build type-checks it.
    "noEmit": true,
    "types": ["vite/client"],
    // vite/catalogue-html.ts imports the catalogue by its file name, for Vite's config loader (Story 4.1).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite"]
}
