{
  "name": "@gatekeep/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "fonts": "node scripts/fonts.mjs",
    "check": "node scripts/fonts.mjs --check && node scripts/check-no-raw-hex.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@gatekeep/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "geist": "catalog:",
    "typescript": "catalog:"
  }
}
