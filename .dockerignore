# Image builds copy only what restore and publish need (deploy/docker/*.Dockerfile).
# apps/ and packages/ stay in the context: admin.Dockerfile builds the Admin Dashboard bundle
# from the pnpm workspace. One shared file, because the classic builder (no BuildKit, as
# in the stack check) ignores per-Dockerfile ignore files.
**/bin/
**/obj/
**/node_modules/
**/dist/
**/TestResults/
.git/
.vs/
.claude/
_bmad/
_bmad-output/
graft/
design/
docs/
deploy/secrets*/
deploy/trust/
deploy/release.env
dist/
**/.env*
**/*.pem
**/*.pfx
