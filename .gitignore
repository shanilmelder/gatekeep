# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local Claude Code session telemetry; contains prompt text.
/.claude/pipeline-status.jsonl
# BMAD install answers scoped to the individual user.
/_bmad/config.user.toml

# Build output.
bin/
obj/
node_modules/
dist/
# Playwright output.
/tests/browser/test-results/
/tests/browser/playwright-report/

# Secrets.
.env*
*.pem
*.pfx

# Tool output.
.vs/
*.user
TestResults/
*.tsbuildinfo

# The Docker host's secrets directory (docs/install.md). Never committed or backed up.
/deploy/secrets/
/deploy/secrets-*/

# Parallel Claude Code worktrees (git worktree add .claude/worktrees/...). Never committed.
/.claude/worktrees/

# The Docker host's pinned release key directory, and the release.env of the release being
# deployed (docs/install.md, "Install a signed release"). Host state, never committed.
/deploy/trust/
/deploy/release.env
