# OpenBao for Gatekeep key custody (AD-10). Install as /etc/systemd/system/openbao.service.
# Written for Story 1.7 but never started under systemd: no Linux host exists yet (G-10).
# docs/key-custody.md has the first setup steps.

[Unit]
Description=OpenBao key custody for Gatekeep
Documentation=https://openbao.org/docs/
# The key volume and the OpenBao data volume are separate LUKS volumes, unlocked by a
# person at boot. Without them OpenBao must not start, so each is required and asserted.
RequiresMountsFor=/srv/gatekeep/keys /var/lib/openbao
AssertPathIsMountPoint=/srv/gatekeep/keys
AssertPathIsMountPoint=/var/lib/openbao

[Service]
Type=notify
User=openbao
Group=openbao
SupplementaryGroups=gatekeep-custody

# The Master Key file is root:root 0400. systemd reads it as root and gives this
# service its own copy in $CREDENTIALS_DIRECTORY. A missing file fails the start.
# Never LoadCredentialEncrypted= or systemd-creds: there is no TPM design yet.
LoadCredential=master-key:/srv/gatekeep/keys/master-key

ExecStart=/usr/bin/bao server -config=/etc/openbao/openbao.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# /run/openbao for the socket. The socket itself is 0660 with group gatekeep-custody.
RuntimeDirectory=openbao
RuntimeDirectoryMode=0755
LogsDirectory=openbao
LogsDirectoryMode=0700
ReadWritePaths=/var/lib/openbao
UMask=0077
LimitCORE=0

# Hardening. PrivateNetwork keeps the loopback listener in openbao.hcl unreachable.
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
